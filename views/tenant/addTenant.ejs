<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
    <title>Add Tenant | Society Management</title>
    <style>
      :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --glass-bg: rgba(255, 255, 255, 0.95);
        --text-main: #2c3e50;
        --text-muted: #7f8c8d;
      }

      body {
        font-family: 'Outfit', sans-serif;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        min-height: 100vh;
        color: var(--text-main);
      }

      .premium-card {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 800px;
        overflow: hidden;
      }

      .header-section {
        background: var(--primary-gradient);
        padding: 2.5rem 1rem;
        text-align: center;
        color: white;
      }

      .header-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        background: rgba(255, 255, 255, 0.2);
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin-left: auto;
        margin-right: auto;
      }

      .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-main);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .icon-input {
        position: relative;
      }

      .icon-input i {
        position: absolute;
        left: 1.2rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 1rem;
        transition: color 0.3s;
        z-index: 5;
      }

      .form-control,
      .form-select {
        padding: 0.8rem 1.2rem 0.8rem 3.2rem;
        border-radius: 14px;
        border: 1.5px solid #e2e8f0;
        background-color: #f8fafc;
        font-size: 0.95rem;
        transition: all 0.3s ease;
      }

      .form-control:focus,
      .form-select:focus {
        background-color: white;
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        outline: none;
      }

      .form-control:focus+i,
      .form-select:focus+i {
        color: #667eea;
      }

      .error-text {
        color: #e74c3c;
        font-size: 0.75rem;
        font-weight: 500;
        margin-top: 4px;
        min-height: 18px;
      }

      .btn-premium {
        background: var(--primary-gradient);
        border: none;
        color: white !important;
        padding: 1rem 2rem;
        border-radius: 14px;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 15px -3px rgba(118, 75, 162, 0.3);
      }

      .btn-premium:hover {
        transform: translateY(-2px);
        background: var(--primary-gradient);
        box-shadow: 0 20px 25px -5px rgba(118, 75, 162, 0.4);
      }

      .back-link {
        color: var(--text-muted);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1.5rem;
        font-weight: 500;
        transition: 0.2s;
        background: white;
        padding: 8px 16px;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      }

      .back-link:hover {
        color: var(--text-main);
        transform: translateX(-5px);
        background: #f8fafc;
      }

      .section-divider {
        border-bottom: 2px solid #edf2f7;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        color: #667eea;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.8rem;
      }

      .overflow-auto-custom {
        max-height: 80vh;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #667eea #f1f1f1;
      }

      /* Dynamic Document Styles */
      .document-row {
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        position: relative;
        transition: all 0.3s ease;
      }

      .document-row:hover {
        border-color: #667eea;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
      }

      .remove-row-btn {
        position: absolute;
        top: -12px;
        right: -12px;
        background: #ef4444;
        color: white;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(239, 68, 68, 0.2);
        transition: all 0.2s;
        z-index: 10;
      }

      .remove-row-btn:hover {
        transform: scale(1.1) rotate(90deg);
        background: #dc2626;
      }

      .add-doc-btn {
        background: white;
        border: 2px dashed #667eea;
        color: #667eea;
        padding: 1rem;
        border-radius: 12px;
        width: 100%;
        font-weight: 600;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 2rem;
      }

      .add-doc-btn:hover {
        background: #f5f7ff;
        border-style: solid;
        transform: translateY(-2px);
      }

      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
</head>

<body>
  <div class="container-fluid">
    <div class="row g-0">
      <div class="col-lg-2">
        <%- include("../partials/leftSidebar") %>
      </div>

      <div class="col-lg-10 min-vh-100 d-flex flex-column align-items-center justify-content-center py-5">
        <div style="width: 100%; max-width: 800px;">
          <a href="/tenant/tenantManagement" class="back-link animate__animated animate__fadeInLeft">
            <i class="fa-solid fa-arrow-left"></i> Back to Tenants
          </a>

          <div class="premium-card animate__animated animate__fadeInUp">
            <div class="header-section">
              <div class="header-icon">
                <i class="fa-solid fa-house-user"></i>
              </div>
              <h2 class="fw-bold mb-1">Add New Tenant</h2>
              <p class="mb-0 opacity-75 small text-uppercase fw-bold">Resident Rental Registration</p>
            </div>

            <div class="card-body p-4 p-md-5">
              <% if (typeof error !=='undefined' && error) { %>
                <div
                  class="alert alert-danger border-0 rounded-4 text-center mb-4 py-3 shadow-sm animate__animated animate__shakeX">
                  <i class="fa-solid fa-triangle-exclamation me-2"></i>
                  <%= error %>
                </div>
                <% } %>

                  <div class="overflow-auto-custom px-2">
                    <form method="POST" action="/tenant/addTenant" enctype="multipart/form-data"
                      onsubmit="return validateForm()">
                      <!-- PERSONAL -->
                      <div class="section-divider">Personal Information</div>
                      <div class="row g-4 mb-5">
                        <div class="col-md-4">
                          <label class="form-label">First Name <span class="text-danger">*</span></label>
                          <div class="icon-input">
                            <i class="fa-solid fa-user"></i>
                            <input type="text" id="firstName" name="firstName" class="form-control" placeholder="John"
                              value="<%= (typeof oldData !== 'undefined' && oldData.firstName) ? oldData.firstName : '' %>"
                              oninput="validateFirstName(this); this.value=this.value.replace(/[^A-Za-z ]/g,'')">
                          </div>
                          <div id="firstNameErr" class="error-text"></div>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label">Middle Name</label>
                          <div class="icon-input">
                            <i class="fa-solid fa-user-large"></i>
                            <input type="text" id="middleName" name="middleName" class="form-control"
                              placeholder="Quincy"
                              value="<%= (typeof oldData !== 'undefined' && oldData.middleName) ? oldData.middleName : '' %>"
                              oninput="this.value=this.value.replace(/[^A-Za-z ]/g,''); validateOptionalName(this,'middleNameErr')">
                          </div>
                          <div id="middleNameErr" class="error-text"></div>
                        </div>
                        <div class="col-md-4">
                          <label class="form-label">Last Name <span class="text-danger">*</span></label>
                          <div class="icon-input">
                            <i class="fa-solid fa-user-group"></i>
                            <input type="text" id="lastName" name="lastName" class="form-control" placeholder="Doe"
                              value="<%= (typeof oldData !== 'undefined' && oldData.lastName) ? oldData.lastName : '' %>"
                              oninput="validateLastName(this); this.value=this.value.replace(/[^A-Za-z ]/g,'')">
                          </div>
                          <div id="lastNameErr" class="error-text"></div>
                        </div>

                        <div class="col-md-6">
                          <label class="form-label">Primary Mobile <span class="text-danger">*</span></label>
                          <div class="icon-input">
                            <i class="fa-solid fa-phone"></i>
                            <input type="text" id="mobile" name="firstMobileNo" class="form-control" maxlength="10"
                              placeholder="10-digit number"
                              value="<%= (typeof oldData !== 'undefined' && oldData.firstMobileNo) ? oldData.firstMobileNo : '' %>"
                              oninput="this.value=this.value.replace(/[^0-9]/g,''); validateMobile(this)">
                          </div>
                          <div id="mobileErr" class="error-text"></div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label">Alternate Mobile</label>
                          <div class="icon-input">
                            <i class="fa-solid fa-phone-volume"></i>
                            <input type="text" id="altMobile" name="secondMobileNo" class="form-control" maxlength="10"
                              placeholder="Optional"
                              value="<%= (typeof oldData !== 'undefined' && oldData.secondMobileNo) ? oldData.secondMobileNo : '' %>"
                              oninput="this.value=this.value.replace(/[^0-9]/g,''); validateAltMobile(this)">
                          </div>
                          <div id="altMobileErr" class="error-text"></div>
                        </div>

                        <div class="col-12">
                          <label class="form-label">Email Address <span class="text-danger">*</span></label>
                          <div class="icon-input">
                            <i class="fa-solid fa-envelope"></i>
                            <input type="email" id="email" name="email" class="form-control"
                              placeholder="john.doe@example.com"
                              value="<%= (typeof oldData !== 'undefined' && oldData.email) ? oldData.email : '' %>"
                              oninput="validateEmail(this)">
                          </div>
                          <div id="emailErr" class="error-text"></div>
                        </div>
                      </div>

                      <!-- ADDRESS -->
                      <div class="section-divider">Address Details</div>
                      <div class="row g-4 mb-5">
                        <div class="col-md-6">
                          <label class="form-label">Current State <span class="text-danger">*</span></label>
                          <div class="icon-input">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <input type="text" id="state" name="state" class="form-control"
                              placeholder="e.g. Maharashtra"
                              value="<%= (typeof oldData !== 'undefined' && oldData.state) ? oldData.state : '' %>"
                              oninput="this.value=this.value.replace(/[^A-Za-z ]/g,''); validateRequired(this,'stateErr')">
                          </div>
                          <div id="stateErr" class="error-text"></div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label">Pincode <span class="text-danger">*</span></label>
                          <div class="icon-input">
                            <i class="fa-solid fa-location-pin"></i>
                            <input type="text" id="pincode" name="pincode" maxlength="6" class="form-control"
                              placeholder="400001"
                              value="<%= (typeof oldData !== 'undefined' && oldData.pincode) ? oldData.pincode : '' %>"
                              oninput="this.value=this.value.replace(/[^0-9]/g,''); validatePincode(this)">
                          </div>
                          <div id="pincodeErr" class="error-text"></div>
                        </div>
                      </div>

                      <!-- DOCUMENTS -->
                      <div class="section-divider">Identity Proof Documents</div>

                      <div id="documentsContainer">
                        <!-- Initial Row -->
                        <div class="document-row animate__animated animate__fadeIn">
                          <div class="row g-4">

                            <div class="col-md-6">
                              <label class="form-label">Document Type <span class="text-danger">*</span></label>
                              <div class="icon-input">
                                <i class="fa-solid fa-id-badge"></i>
                                <select name="documents[0][documentType]" class="form-select doc-type" required
                                  onchange="validateSelect(this, 'docTypeErr0'); preventDuplicateDocTypes();">

                                  <option value="">Select Document Type</option>

                                  <option value="AADHAR" <%=(typeof oldData !=='undefined' && oldData.documents &&
                                    oldData.documents[0] && oldData.documents[0].documentType==='AADHAR' ) ? 'selected'
                                    : '' %>>
                                    Aadhaar
                                  </option>

                                  <option value="DL" <%=(typeof oldData !=='undefined' && oldData.documents &&
                                    oldData.documents[0] && oldData.documents[0].documentType==='DL' ) ? 'selected' : ''
                                    %>>
                                    Driving Licence
                                  </option>

                                  <option value="PAN" <%=(typeof oldData !=='undefined' && oldData.documents &&
                                    oldData.documents[0] && oldData.documents[0].documentType==='PAN' ) ? 'selected'
                                    : '' %>>
                                    PAN Card
                                  </option>

                                  <option value="PASSPORT" <%=(typeof oldData !=='undefined' && oldData.documents &&
                                    oldData.documents[0] && oldData.documents[0].documentType==='PASSPORT' )
                                    ? 'selected' : '' %>>
                                    Passport
                                  </option>
                                  <option value="VOTER_ID" <%=(typeof oldData !=='undefined' && oldData.documents &&
                                    oldData.documents[0] && oldData.documents[0].documentType==='VOTER_ID' )
                                    ? 'selected' : '' %>>
                                    Voter ID
                                  </option>

                                  <option value="POLICE_VERIFICATION" <%=(typeof oldData !=='undefined' &&
                                    oldData.documents && oldData.documents[0] &&
                                    oldData.documents[0].documentType==='POLICE_VERIFICATION' ) ? 'selected' : '' %>>
                                    Police Verification
                                  </option>

                                  <option value="RENTAL_AGREEMENT" <%=(typeof oldData !=='undefined' &&
                                    oldData.documents && oldData.documents[0] &&
                                    oldData.documents[0].documentType==='RENTAL_AGREEMENT' ) ? 'selected' : '' %>>
                                    Rental Agreement
                                  </option>

                                </select>
                              </div>
                              <div id="docTypeErr0" class="error-text"></div>
                            </div>

                            <div class="col-md-6">
                              <label class="form-label">Upload Files <span class="text-danger">*</span></label>
                              <div class="icon-input">
                                <i class="fa-solid fa-cloud-arrow-up"></i>

                                <input type="file" name="documents[0][files]" class="form-control doc-files"
                                  accept="image/png, image/jpeg, image/jpg" multiple>
                              </div>

                              <div id="filesErr0" class="error-text"></div>
                            </div>

                          </div>
                        </div>
                      </div>

                      <button type="button" class="add-doc-btn" onclick="addDocumentRow()">
                        <i class="fa-solid fa-plus-circle"></i> Add Another Document Type
                      </button>

                      <div class="d-grid pt-3">
                        <button type="submit" class="btn-premium btn-lg">
                          <i class="fa-solid fa-check-circle me-2"></i> Register Tenant Profile
                        </button>
                      </div>
                    </form>
                  </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include("../partials/script") %>
    <script>
      function validateFirstName(el) {
        const err = document.getElementById("firstNameErr");
        if (el.value.trim() === "") { err.innerText = "First name required"; return false; }
        if (!/^[A-Za-z ]+$/.test(el.value)) { err.innerText = "Only letters allowed"; return false; }
        err.innerText = ""; return true;
      }
      function validateLastName(el) {
        const err = document.getElementById("lastNameErr");
        if (el.value.trim() === "") { err.innerText = "Last name required"; return false; }
        if (!/^[A-Za-z ]+$/.test(el.value)) { err.innerText = "Only letters allowed"; return false; }
        err.innerText = ""; return true;
      }
      function validateOptionalName(el, id) {
        const err = document.getElementById(id);
        if (el.value !== "" && !/^[A-Za-z ]+$/.test(el.value)) { err.innerText = "Only letters allowed"; return false; }
        err.innerText = ""; return true;
      }
      function validateMobile(el) {
        const err = document.getElementById("mobileErr");
        if (!/^[6-9][0-9]{9}$/.test(el.value)) { err.innerText = "Must start with 6-9 (10 digits)"; return false; }
        err.innerText = ""; return true;
      }
      function validateAltMobile(el) {
        const err = document.getElementById("altMobileErr");
        if (el.value !== "" && !/^[6-9][0-9]{9}$/.test(el.value)) { err.innerText = "Invalid alternate mobile"; return false; }
        err.innerText = ""; return true;
      }
      function validateEmail(el) {
        const err = document.getElementById("emailErr");
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!re.test(el.value)) { err.innerText = "Enter a valid email address"; return false; }
        err.innerText = ""; return true;
      }
      function validateRequired(el, id) {
        const err = document.getElementById(id);
        if (el.value.trim() === "") { err.innerText = "This field is required"; return false; }
        err.innerText = ""; return true;
      }
      function validatePincode(el) {
        const err = document.getElementById("pincodeErr");
        if (!/^[1-9][0-9]{5}$/.test(el.value)) { err.innerText = "Must be a 6-digit pincode"; return false; }
        err.innerText = ""; return true;
      }
      function validateSelect(el, id) {
        const err = document.getElementById(id);
        if (el.value === "") { err.innerText = "Selection required"; return false; }
        err.innerText = ""; return true;
      }

      function preventDuplicateDocTypes() {
        const selects = document.querySelectorAll(".doc-type");
        const used = [];
        selects.forEach(sel => {
          if (sel.value) {
            if (used.includes(sel.value)) {
              alert("Same document type cannot be selected twice");
              sel.value = "";
            } else {
              used.push(sel.value);
            }
          }
        });
      }

      let rowCount = 1;

      function addDocumentRow() {
        const container = document.getElementById("documentsContainer");
        const currentIndex = rowCount;
        const row = document.createElement("div");

        row.className = "document-row animate__animated animate__zoomIn";
        row.innerHTML = `
      <button type="button" class="remove-row-btn"
        onclick="this.parentElement.remove()" title="Remove this document">
        <i class="fa-solid fa-trash-can"></i>
      </button>

      <div class="row g-4">
        <div class="col-md-6">
          <label class="form-label">Document Type <span class="text-danger">*</span></label>
          <div class="icon-input">
            <i class="fa-solid fa-id-badge"></i>
            <select name="documents[${currentIndex}][documentType]"
              class="form-select doc-type"
              onchange="validateSelect(this, 'docTypeErr${currentIndex}'); preventDuplicateDocTypes();"
              required>
              <option value="">Select ID Type</option>
              <option value="AADHAR">Aadhaar</option>
              <option value="DL">Driving Licence</option>
              <option value="PAN">PAN Card</option>
              <option value="PASSPORT">Passport</option>
              <option value="VOTER_ID">Voter ID</option>
              <option value="POLICE_VERIFICATION">Police Verification</option>
              <option value="RENTAL_AGREEMENT">Rental Agreement</option>
            </select>
          </div>
          <div id="docTypeErr${currentIndex}" class="error-text"></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Upload Files <span class="text-danger">*</span></label>
          <div class="icon-input">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <input type="file"
              name="documents[${currentIndex}][files]"
              class="form-control doc-files"
              accept="image/png, image/jpeg, image/jpg"
              multiple>
          </div>
          <div id="filesErr${currentIndex}" class="error-text"></div>
        </div>
      </div>
    `;

        container.appendChild(row);
        rowCount++;
      }

      function validateForm() {
        const v1 = validateFirstName(document.getElementById("firstName"));
        const v2 = validateLastName(document.getElementById("lastName"));
        const v3 = validateMobile(document.getElementById("mobile"));
        const v4 = validateEmail(document.getElementById("email"));
        const v5 = validateRequired(document.getElementById("state"), 'stateErr');
        const v6 = validatePincode(document.getElementById("pincode"));

        let docsValid = true;
        document.querySelectorAll(".document-row").forEach((row) => {
          const select = row.querySelector(".doc-type");
          const fileInput = row.querySelector(".doc-files");

          const indexMatch = select.name.match(/\[(\d+)\]/);
          const errId = indexMatch ? indexMatch[1] : 0;

          if (!select.value) {
            const errDoc = document.getElementById(`docTypeErr${errId}`);
            if (errDoc) errDoc.innerText = "Selection required";
            docsValid = false;
          }

          if (!fileInput.files || fileInput.files.length === 0) {
            const errFile = document.getElementById(`filesErr${errId}`);
            if (errFile) errFile.innerText = "At least one file required";
            docsValid = false;
          }
        });

        if (!(v1 && v2 && v3 && v4 && v5 && v6 && docsValid)) {
          const firstErr = document.querySelector(".error-text:not(:empty)");
          if (firstErr) {
            firstErr.closest('.row')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          return false;
        }
        return true;
      }
    </script>
</body>

</html>