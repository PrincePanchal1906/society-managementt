<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
        <title>Document Viewer | Society Management</title>
        <style>
            :root {
                --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                --glass-bg: rgba(255, 255, 255, 0.95);
                --text-main: #2c3e50;
                --text-muted: #7f8c8d;
            }

            body {
                font-family: 'Outfit', sans-serif;
                background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
                min-height: 100vh;
                color: var(--text-main);
            }

            .premium-card {
                background: var(--glass-bg);
                backdrop-filter: blur(20px);
                border-radius: 24px;
                border: 1px solid rgba(255, 255, 255, 0.8);
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
                width: 100%;
                max-width: 1000px;
                overflow: hidden;
                margin-bottom: 2rem;
            }

            .header-section {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .header-icon {
                font-size: 2.5rem;
                margin-bottom: 0.5rem;
                background: rgba(255, 255, 255, 0.2);
                width: 70px;
                height: 70px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                margin: 0 0 1rem;
                /* ✅ auto હટાવી દીધું */
            }

            .doc-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                gap: 1.5rem;
                padding: 2rem;
            }

            .doc-card {
                background: white;
                border-radius: 16px;
                padding: 1.5rem;
                border: 1px solid #e2e8f0;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }

            .doc-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
                border-color: #667eea;
            }

            .doc-type-badge {
                background: #f0f4ff;
                color: #667eea;
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 1rem;
                display: inline-block;
            }

            .file-list {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
            }

            .file-item {
                position: relative;
                width: 80px;
                height: 80px;
                border-radius: 12px;
                overflow: hidden;
                border: 2px solid #edf2f7;
                cursor: pointer;
            }

            .file-preview {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .file-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.4);
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                transition: opacity 0.3s;
            }

            .file-item:hover .file-overlay {
                opacity: 1;
            }

            .eye-icon {
                color: white;
                font-size: 1.2rem;
            }

            .back-btn {
                background: white;
                color: var(--text-main);
                padding: 0.5rem 1.2rem;
                border-radius: 12px;
                text-decoration: none;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
                margin-bottom: 1.5rem;
            }

            .back-btn:hover {
                background: #f8fafc;
                transform: translateX(-5px);
            }

            .no-docs {
                text-align: center;
                padding: 4rem;
                color: var(--text-muted);
            }

            .no-docs i {
                font-size: 3rem;
                margin-bottom: 1rem;
                opacity: 0.3;
            }
        </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row g-0">
            <div class="col-lg-2">
                <%- include("../partials/leftSidebar") %>
            </div>

            <div class="col-lg-10 p-4 min-vh-100 d-flex flex-column align-items-center">
                <div style="width: 100%; max-width: 1000px;">
                    <a href="javascript:history.back()" class="back-btn animate__animated animate__fadeInLeft">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>

                    <div class="premium-card animate__animated animate__fadeInUp">
                        <div class="header-section">
                            <div class="header-section">
                                <div class="header-icon">
                                    <i class="fa-solid fa-folder-open"></i>
                                </div>

                                <div class="header-text">
                                    <h3 class="fw-bold mb-0 text-white">Documents</h3>
                                    <p class="mb-0 mt-1 small opacity-75 text-uppercase fw-bold text-white">
                                        <%= type %>: <%= entity.firstName %>
                                                <%= entity.lastName %>
                                    </p>
                                </div>
                            </div>

                        </div>

                        <div class="card-body p-0">
                            <% if (documents && documents.length> 0) { %>
                                <div class="doc-grid">
                                    <% documents.forEach((doc, idx)=> { %>
                                        <div class="doc-card">
                                            <span class="doc-type-badge">
                                                <%= doc.documentType.replace(/_/g, ' ' ) %>
                                            </span>
                                            <div class="file-list">
                                                <% if (doc.filesPath && doc.filesPath.length> 0) { %>
                                                    <% doc.filesPath.forEach((path, fIdx)=> { %>
                                                        <a href="<%= path %>" target="_blank" class="file-item"
                                                            title="View Document">
                                                            <img src="<%= path %>" class="file-preview"
                                                                alt="<%= doc.documentType %>">
                                                            <div class="file-overlay">
                                                                <i class="fa-solid fa-eye eye-icon"></i>
                                                            </div>
                                                        </a>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <p class="small text-muted mb-0">No files uploaded.</p>
                                                                <% } %>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <div class="no-docs">
                                        <i class="fa-solid fa-file-circle-exclamation"></i>
                                        <p class="mb-0">No documents found for this resident.</p>
                                    </div>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include("../partials/script") %>
</body>

</html>