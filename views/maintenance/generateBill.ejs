<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Generate Maintenance - All Flats</title>

    <!-- Bootstrap CSS (જો project માં already હોય તો remove કરશો) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background: #f5f7fb;
            font-family: Arial, sans-serif;
        }

        .hero {
            border-radius: 18px;
            background: linear-gradient(120deg, #0d6efd 0%, #6f42c1 100%);
            color: #fff;
            padding: 22px;
            box-shadow: 0 12px 30px rgba(13, 110, 253, 0.25);
        }

        .main-card {
            border: 0;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
        }

        .input-box {
            border-radius: 14px;
            padding: 12px 14px;
            border: 1px solid rgba(0, 0, 0, 0.08);
        }

        .btn-main {
            border-radius: 14px;
            padding: 12px 14px;
            font-weight: 700;
        }

        .info-card {
            border: 0;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
        }

        .mini-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(13, 110, 253, 0.12);
            color: #0d6efd;
            font-size: 20px;
        }

        .text-small {
            font-size: 13px;
            color: #6c757d;
        }
    </style>
</head>

<body>
    <div class="container py-4">

        <!-- ✅ Top Banner -->
        <div class="hero mb-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h3 class="mb-1 fw-bold">
                        <i class="bi bi-lightning-charge-fill"></i> Generate Maintenance
                    </h3>
                </div>

                <div class="d-flex gap-2">
                    <a href="/maintenance" class="btn btn-light fw-bold" style="border-radius: 14px;">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        </div>

        <div class="row g-4">

            <!-- ✅ Left Form -->
            <div class="col-lg-7">
                <div class="card main-card p-4">
                    <h4 class="fw-bold mb-1">Generate Bills For All Flats</h4>

                    <form action="/maintenance/generate-all" method="POST">

                        <!-- Date -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Select Date</label>
                            <div class="input-group">
                                <span class="input-group-text" style="border-radius:14px 0 0 14px;">
                                    <i class="bi bi-calendar2-week"></i>
                                </span>
                                <input type="date" name="month" class="form-control input-box" required />
                            </div>
                        </div>

                        <!-- Amount -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Maintenance Amount (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text" style="border-radius:14px 0 0 14px;">
                                    <i class="bi bi-cash-coin"></i>
                                </span>
                                <input type="string" name="amount" class="form-control input-box" placeholder="Ex: 1500"
                                    oninput="this.value = this.value.replace(/[^0-9]/g, '');" maxlength="9" required />
                            </div>
                        </div>
                        <!-- Details -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Details</label>
                            <div class="input-group">
                                <span class="input-group-text" style="border-radius:14px 0 0 14px;">
                                    <i class="bi bi-card-text"></i>
                                </span>
                                <input type="text" name="details" class="form-control input-box"
                                    placeholder="Ex: Lift Repair / Water Bill" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-main w-100">
                            <i class="bi bi-plus-circle"></i> Generate Bills Now
                        </button>

                    </form>
                </div>
            </div>



            <!-- Bootstrap JS (જો project માં already હોય તો remove કરશો) -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>