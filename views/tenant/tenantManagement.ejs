<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
    <title>Tenant Management | Society Management</title>
</head>

<body>
  <div class="container-fluid">
    <div class="row g-0">
      <!-- Sidebar -->
      <div class="col-lg-2">
        <%- include("../partials/leftSidebar") %>
      </div>

      <!-- Content Area -->
      <div class="col-lg-10 p-4 min-vh-100">
        <div class="premium-card p-2 animate__animated animate__fadeIn">
          <!-- Header Section -->
          <div class="header-section">
            <div>
              <h3 class="fw-bold mb-0"><i class="fa-solid fa-house-chimney-user me-2"></i>Tenant Management</h3>
              <p class="mb-0 small opacity-75 text-uppercase fw-bold">Society Resident Directory</p>
            </div>
            <a href="/tenant/addTenant" class="btn-premium">
              <i class="fa-solid fa-plus-circle me-1"></i> Add Tenant
            </a>
          </div>

          <div class="px-3 pb-3">
            <!-- Search Container -->
            <div class="search-container mt-4">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="text" id="searchInput" class="search-input"
                placeholder="Search by name, mobile, email, state...">
            </div>

            <% if (typeof error !=='undefined' && error) { %>
              <div class="alert alert-danger alert-dismissible fade show mt-3 border-0 shadow-sm" role="alert"
                style="border-radius: 12px; background: rgba(220, 53, 69, 0.1); color: #dc3545;">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                <%= error %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
              <% } %>

                <!-- Table Area -->
                <div class="table-responsive">
                  <table class="table fancy-table" id="tenantTable" data-sort="asc">
                    <thead>
                      <tr>
                        <th onclick="sortTable(0)" style="cursor: pointer;">Name <i
                            class="fa-solid fa-sort ms-1 opacity-50"></i></th>
                        <th onclick="sortTable(1)" style="cursor: pointer;">Contact <i
                            class="fa-solid fa-sort ms-1 opacity-50"></i></th>
                        <th>Email Address</th>
                        <th>Location</th>
                        <th class="text-center">ID Proof</th>
                        <th class="text-center">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (tenants.length===0) { %>
                        <tr>
                          <td colspan="6" class="text-center py-5">
                            <i class="fa-solid fa-users-slash d-block mb-3 fs-1 opacity-25 text-muted"></i>
                            No tenants registered in the system
                          </td>
                        </tr>
                        <% } else { %>
                          <% tenants.forEach((t, index)=> { %>
                            <tr class="animate__animated animate__fadeInUp"
                              style="animation-delay: <%= index * 0.05 %>s">
                              <td>
                                <div class="fw-bold text-dark">
                                  <%= t.firstName %>
                                    <%= t.lastName || "" %>
                                </div>
                                <div class="text-muted small text-uppercase font-monospace" style="font-size: 0.7rem;">
                                  Resident Tenant</div>
                              </td>
                              <td>
                                <div class="small fw-bold"><i
                                    class="fa-solid fa-phone me-2 opacity-50 text-success"></i>
                                  <%= t.firstMobileNo %>
                                </div>
                                <% if (t.secondMobileNo) { %>
                                  <div class="text-muted small"><i class="fa-solid fa-phone-flip me-2 opacity-50"></i>
                                    <%= t.secondMobileNo %>
                                  </div>
                                  <% } %>
                              </td>
                              <td>
                                <div class="small fw-medium">
                                  <%= t.email || "N/A" %>
                                </div>
                              </td>
                              <td>
                                <div class="small fw-bold">
                                  <%= t.state || "-" %>
                                </div>
                                <div class="text-muted small"><i class="fa-solid fa-location-dot me-1 opacity-50"></i>
                                  <%= t.pincode || "-" %>
                                </div>
                              </td>
                              <td class="text-center">
                                <a href="/document-master/document-viewer/tenant/<%= t._id %>"
                                  class="badge-premium text-decoration-none">
                                  <%= (t.documents && t.documents.length> 0) ? t.documents[0].documentType : 'No ID' %>
                                    <i class="fa-solid fa-file-arrow-down ms-1 small"></i>
                                </a>
                              </td>
                              <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                  <a href="/tenant/updateTenant/<%= t._id %>" class="action-icon btn-edit"
                                    title="Edit Tenant">
                                    <i class="fa-solid fa-user-pen"></i>
                                  </a>
                                  <a href="/tenant/deleteTenant/<%= t._id %>" class="action-icon btn-delete"
                                    title="Delete Tenant"
                                    onclick="return confirm('Permanently remove this tenant registry?')">
                                    <i class="fa-solid fa-user-xmark"></i>
                                  </a>
                                </div>
                              </td>
                            </tr>
                            <% }) %>
                              <% } %>
                    </tbody>
                  </table>
                </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include("../partials/script") %>

    <script>
      // SEARCH
      document.getElementById("searchInput").addEventListener("keyup", function () {
        const value = this.value.toLowerCase();
        const rows = document.querySelectorAll("#tenantTable tbody tr:not(:has([colspan]))");

        rows.forEach(row => {
          const text = row.innerText.toLowerCase();
          row.style.display = text.includes(value) ? "" : "none";
        });
      });

      // SORT
      function sortTable(colIndex) {
        const table = document.getElementById("tenantTable");
        const tbody = table.tBodies[0];
        const rows = Array.from(tbody.rows);
        if (rows[0] && rows[0].innerText.includes("No tenants")) return;

        const asc = table.getAttribute("data-sort") !== "asc";

        rows.sort((a, b) => {
          const A = a.cells[colIndex].innerText.toLowerCase().trim();
          const B = b.cells[colIndex].innerText.toLowerCase().trim();
          return asc ? A.localeCompare(B) : B.localeCompare(A);
        });

        rows.forEach(r => tbody.appendChild(r));
        table.setAttribute("data-sort", asc ? "asc" : "desc");

        // Update sort icons
        const ths = table.querySelectorAll("th");
        ths.forEach((th, i) => {
          const icon = th.querySelector("i");
          if (icon) {
            if (i === colIndex) {
              icon.className = asc ? "fa-solid fa-sort-up ms-1" : "fa-solid fa-sort-down ms-1";
              icon.style.opacity = "1";
            } else {
              icon.className = "fa-solid fa-sort ms-1 opacity-50";
            }
          }
        });
      }
    </script>
</body>

</html>