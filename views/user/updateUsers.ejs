<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("./partials/head") %>
    <title>Update User | Society Management</title>
    <style>
      :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --glass-bg: rgba(255, 255, 255, 0.95);
        --text-main: #2c3e50;
        --text-muted: #7f8c8d;
      }

      body {
        font-family: 'Outfit', sans-serif;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        min-height: 100vh;
        color: var(--text-main);
      }

      .premium-card {
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 600px;
        overflow: hidden;
      }

      .header-section {
        background: var(--primary-gradient);
        padding: 2.5rem 1rem;
        text-align: center;
        color: white;
      }

      .header-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        background: rgba(255, 255, 255, 0.2);
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin-left: auto;
        margin-right: auto;
      }

      .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-main);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .icon-input {
        position: relative;
      }

      .icon-input i {
        position: absolute;
        left: 1.1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 0.95rem;
        transition: color 0.3s;
        z-index: 5;
      }

      .form-control,
      .form-select {
        padding: 0.75rem 1rem 0.75rem 2.8rem;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        background-color: #f8fafc;
        font-size: 0.9rem;
        transition: all 0.3s ease;
      }

      .form-control:focus,
      .form-select:focus {
        background-color: white;
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        outline: none;
      }

      .form-control:focus+i,
      .form-select:focus+i {
        color: #667eea;
      }

      .btn-premium {
        background: var(--primary-gradient);
        border: none;
        color: white !important;
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        box-shadow: 0 8px 12px -2px rgba(118, 75, 162, 0.25);
      }

      .btn-premium:hover {
        transform: translateY(-2px);
        background: var(--primary-gradient);
        box-shadow: 0 15px 20px -4px rgba(118, 75, 162, 0.35);
      }

      .back-link {
        color: var(--text-muted);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1.5rem;
        font-weight: 500;
        transition: 0.2s;
        background: white;
        padding: 8px 16px;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      }

      .back-link:hover {
        color: var(--text-main);
        transform: translateX(-5px);
        background: #f8fafc;
      }

      .profile-section {
        text-align: center;
        margin-bottom: 2rem;
      }

      .profile-preview {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        background: #f1f5f9;
      }

      .section-divider {
        border-bottom: 2px solid #edf2f7;
        margin-bottom: 1.2rem;
        padding-bottom: 0.4rem;
        color: #667eea;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.75rem;
      }
    </style>
</head>

<body>
  <div class="container-fluid">
    <div class="row g-0">
      <div class="col-lg-2">
        <%- include("./partials/leftSidebar") %>
      </div>

      <div class="col-lg-10 min-vh-100 d-flex flex-column align-items-center justify-content-center py-5">
        <div style="width: 100%; max-width: 600px;">
          <a href="/userManagement" class="back-link animate__animated animate__fadeInLeft">
            <i class="fa-solid fa-arrow-left"></i> Back to Users
          </a>

          <div class="premium-card animate__animated animate__fadeInUp">
            <div class="header-section">
              <div class="header-icon">
                <i class="fa-solid fa-user-pen"></i>
              </div>
              <h3 class="fw-bold mb-1">Update User Profile</h3>
              <p class="mb-0 opacity-75 small text-uppercase">Modifying account for <%= user.name %>
              </p>
            </div>

            <div class="card-body p-4 p-md-5">
              <div class="profile-section">
                <img src="<%= user.profileImage %>" class="profile-preview" onerror="this.src='/uploads/default.jpg'">
              </div>

              <% if (locals.error) { %>
                <div
                  class="alert alert-danger border-0 rounded-4 text-center mb-4 py-3 shadow-sm animate__animated animate__shakeX">
                  <i class="fa-solid fa-triangle-exclamation me-2"></i>
                  <%= error %>
                </div>
                <% } %>

                  <form action="/updateUsers/<%= user._id %>" method="POST" enctype="multipart/form-data" novalidate>
                    <div class="section-divider">Account Identity</div>
                    <div class="row g-4 mb-4">
                      <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <div class="icon-input">
                          <i class="fa-regular fa-user"></i>
                          <input type="text" name="name" class="form-control" value="<%= user.name %>" required
                            pattern="[A-Za-z ]+" oninput="this.value = this.value.replace(/[^A-Za-z ]/g, '')"
                            placeholder="Enter full name">
                        </div>
                      </div>

                      <div class="col-md-6">
                        <label class="form-label">Access Role</label>
                        <div class="icon-input">
                          <i class="fa-solid fa-user-shield"></i>
                          <select name="role" class="form-select">
                            <option value="MEMBER" <%=user.role==='MEMBER' ? 'selected' : '' %>>Member</option>
                            <option value="ADMIN" <%=user.role==='ADMIN' ? 'selected' : '' %>>Admin</option>
                            <option value="MANAGER" <%=user.role==='MANAGER' ? 'selected' : '' %>>Manager</option>
                            <option value="SECRETARY" <%=user.role==='SECRETARY' ? 'selected' : '' %>>Secretary</option>
                          </select>
                        </div>
                      </div>
                    </div>

                    <div class="section-divider">Contact Details</div>
                    <div class="row g-4 mb-4">
                      <div class="col-12">
                        <label class="form-label">Email Address</label>
                        <div class="icon-input">
                          <i class="fa-regular fa-envelope"></i>
                          <input type="email" name="email" id="email" class="form-control" value="<%= user.email %>"
                            onblur="checkEmailBeforeNext()" required placeholder="user@society.com">
                        </div>
                        <small id="emailError" class="text-danger mt-2 d-none fw-500" style="font-size: 0.75rem;">Please
                          enter a valid email address</small>
                      </div>

                      <div class="col-12">
                        <label class="form-label">Phone Number</label>
                        <div class="icon-input">
                          <i class="fa-solid fa-phone"></i>
                          <input type="text" name="phone" id="phone" class="form-control" value="<%= user.phone %>"
                            maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required
                            placeholder="10-digit mobile">
                        </div>
                        <small id="phoneError" class="text-danger mt-2 d-none fw-500" style="font-size: 0.75rem;">Phone
                          number must be exactly 10 digits</small>
                      </div>
                    </div>

                    <div class="section-divider">Profile Customization</div>
                    <div class="mb-5">
                      <label class="form-label">Update Profile Photo</label>
                      <div class="icon-input">
                        <i class="fa-solid fa-image"></i>
                        <input type="file" name="profileImage" class="form-control"
                          accept="image/png, image/jpeg, image/jpg">
                      </div>
                    </div>

                    <div class="d-grid">
                      <button type="submit" class="btn-premium shadow-sm">
                        <i class="fa-solid fa-cloud-arrow-up me-2"></i> Save Changes
                      </button>
                    </div>
                  </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include("./partials/script") %>

    <script>
      function checkEmailBeforeNext() {
        const emailInput = document.getElementById("email");
        const error = document.getElementById("emailError");
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (emailInput.value && !emailRegex.test(emailInput.value)) {
          error.classList.remove("d-none");
          emailInput.classList.add("is-invalid");
        } else {
          error.classList.add("d-none");
          emailInput.classList.remove("is-invalid");
        }
      }

      document.querySelector('form').addEventListener('submit', function (e) {
        const phoneInput = document.getElementById("phone");
        const phoneError = document.getElementById("phoneError");
        if (phoneInput.value.length !== 10) {
          e.preventDefault();
          phoneError.classList.remove("d-none");
          phoneInput.classList.add("is-invalid");
        }
      });
    </script>
</body>

</html>