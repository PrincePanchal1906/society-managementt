<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
    <title>User Management | Society Management</title>
</head>

<body>
  <div class="container-fluid">
    <div class="row g-0">
      <!-- Sidebar -->
      <div class="col-lg-2">
        <%- include("../partials/leftSidebar") %>
      </div>

      <!-- Content Area -->
      <div class="col-lg-10 p-4 min-vh-100">
        <div class="premium-card p-2 animate__animated animate__fadeIn">
          <!-- Header Section -->
          <div class="header-section">
            <div>
              <h3 class="fw-bold mb-0"><i class="fa-solid fa-user-gear me-2"></i>User Management</h3>
              <p class="mb-0 small opacity-75 text-uppercase fw-bold">Manage system administrators and staff</p>
            </div>
            <a href="/add" class="btn-premium">
              <i class="fa-solid fa-user-plus me-1"></i> Add New User
            </a>
          </div>

          <div class="px-3 pb-3">
            <!-- Search & Stats (Optional) Row -->
            <div class="row align-items-center mb-4 mt-2">
              <div class="col-md-6">
                <div class="search-container mb-0">
                  <i class="fa-solid fa-magnifying-glass"></i>
                  <input type="text" id="userSearch" class="search-input"
                    placeholder="Search by name, email or role...">
                </div>
              </div>
            </div>

            <!-- Table Area -->
            <div class="table-responsive">
              <table class="table fancy-table" id="userTable">
                <thead>
                  <tr>
                    <th>User Profile</th>
                    <th>Role Assigned</th>
                    <th>Contact Details</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (users.length===0) { %>
                    <tr>
                      <td colspan="5" class="text-center py-5">
                        <i class="fa-regular fa-folder-open d-block mb-3 fs-1 opacity-25 text-muted"></i>
                        <p class="text-muted">No users found in the system</p>
                        <a href="/add" class="btn btn-sm btn-success rounded-pill px-4">Create First User</a>
                      </td>
                    </tr>
                    <% } else { %>
                      <% users.forEach((u, index)=> { %>
                        <tr class="animate__animated animate__fadeInUp" style="animation-delay: <%= index * 0.05 %>s">
                          <td>
                            <div class="d-flex align-items-center">
                              <div class="position-relative me-3">
                                <img
                                  src="<%= (u.profileImage && u.profileImage.startsWith('/')) ? u.profileImage : '/' + (u.profileImage || 'uploads/default.jpg') %>"
                                  class="rounded-circle border border-2 border-white shadow-sm"
                                  style="width: 45px; height: 45px; object-fit: cover;"
                                  onerror="this.src='/uploads/default.jpg'">
                                <span
                                  class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle"
                                  style="width: 12px; height: 12px;"></span>
                              </div>
                              <div>
                                <div class="fw-bold text-dark">
                                  <%= u.name %>
                                </div>
                                <div class="text-muted small">
                                  <%= u.email %>
                                </div>
                              </div>
                            </div>
                          </td>
                          <td>
                            <span
                              class="badge-premium <%= u.role === 'ADMIN' ? 'bg-warning text-dark' : 'bg-info text-dark' %>"
                              style="font-size: 0.7rem;">
                              <i class="fa-solid <%= u.role === 'ADMIN' ? 'fa-shield-halved' : 'fa-user' %> me-1"></i>
                              <%= u.role %>
                            </span>
                          </td>
                          <td>
                            <div class="small fw-medium">
                              <i class="fa-solid fa-phone me-2 opacity-50 text-success"></i>
                              <%= u.phone || "N/A" %>
                            </div>
                          </td>
                          <td>
                            <span class="text-success small fw-bold">
                              <i class="fa-solid fa-circle-check me-1"></i> Active
                            </span>
                          </td>
                          <td class="text-center">
                            <div class="d-flex justify-content-center gap-1">
                              <a href="/updateUsers/<%= u._id %>" class="action-icon btn-edit" title="Edit User">
                                <i class="fa-solid fa-user-pen"></i>
                              </a>
                              <a href="/deleteUser/<%= u._id %>" class="action-icon btn-delete" title="Remove User"
                                onclick="return confirm('Permanently remove this user?')">
                                <i class="fa-solid fa-trash-can"></i>
                              </a>
                            </div>
                          </td>
                        </tr>
                        <% }) %>
                          <% } %>
                </tbody>
              </table>
            </div>

            <!-- Pagination Footer -->
            <div class="d-flex justify-content-between align-items-center mt-4 px-2">
              <p class="text-muted small mb-0">Total system users: <span class="fw-bold">
                  <%= users.length %>
                </span></p>
              <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                  <li class="page-item disabled"><a class="page-link border-0" href="#">Previous</a></li>
                  <li class="page-item active"><a class="page-link border-0 rounded-3 shadow-sm" href="#">1</a></li>
                  <li class="page-item"><a class="page-link border-0" href="#">Next</a></li>
                </ul>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include("../partials/script") %>

    <script>
      document.getElementById("userSearch").addEventListener("keyup", function () {
        const value = this.value.toLowerCase();
        const rows = document.querySelectorAll("#userTable tbody tr");

        rows.forEach(row => {
          if (row.cells.length > 1) {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(value) ? "" : "none";
          }
        });
      });
    </script>
</body>

</html>