<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
    <title>Fill Resident Details | Society Management</title>
    <style>
      body {
        background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);
        min-height: 100vh;
      }

      .premium-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        max-width: 800px;
        width: 100%;
        margin: 2rem auto;
        animation: fadeIn 0.8s ease;
      }

      .header-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 2.5rem;
        color: white;
        text-align: center;
      }

      .header-icon {
        font-size: 3rem;
        margin-bottom: 0.8rem;
      }

      .info-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #718096;
        font-weight: 700;
        margin-bottom: 0.2rem;
      }

      .info-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1a202c;
        padding: 0.6rem 1rem;
        background: #f8fafc;
        border-radius: 10px;
        border: 1px solid #edf2f7;
        margin-bottom: 1rem;
      }

      .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #2d3748;
      }

      .form-control,
      .form-select {
        border-radius: 12px;
        padding: 0.75rem 1rem;
        border: 1.5px solid #edf2f7;
        background: #f7fafc;
        transition: 0.3s;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: #667eea;
        background: white;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
      }

      .btn-save {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 1rem;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1rem;
        transition: all 0.3s;
        box-shadow: 0 10px 15px -3px rgba(102, 126, 234, 0.3);
      }

      .btn-save:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        box-shadow: 0 20px 25px -5px rgba(102, 126, 234, 0.4);
        color: white;
      }

      .alert-premium {
        background: #fff5f5;
        border-left: 4px solid #f56565;
        color: #c53030;
        border-radius: 12px;
      }

      .back-link {
        color: #718096;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1rem;
        font-weight: 500;
        transition: 0.2s;
      }

      .back-link:hover {
        color: #2d3748;
        transform: translateX(-5px);
      }
    </style>
</head>

<body>
  <div class="container-fluid">
    <div class="row g-0">
      <div class="col-lg-2">
        <%- include("../partials/leftSidebar") %>
      </div>

      <div class="col-lg-10 p-4 min-vh-100 d-flex flex-column align-items-center justify-content-center">

        <div style="width: 100%; max-width: 800px;">
          <a href="javascript:history.back()" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Change Selection
          </a>

          <div class="premium-card">
            <div class="header-gradient">
              <div class="header-icon">
                <i class="fa-solid fa-file-signature"></i>
              </div>
              <h3 class="fw-bold mb-1">Stay Details Confirmation</h3>
              <p class="mb-0 opacity-75 small text-uppercase fw-bold">Finalizing flat registration</p>
            </div>

            <div class="card-body p-4 p-md-5">

              <!-- Read-only Info Grid -->
              <div class="row g-3 mb-4">
                <div class="col-md-6 border-end">
                  <p class="info-label"><i class="fa-solid fa-building me-1 opacity-50"></i> Flat Location</p>
                  <div class="info-value">Block <%= flat?.blockName || '?' %> - Flat <%= flat?.flatNo || '?' %>
                  </div>

                  <p class="info-label"><i class="fa-solid fa-user-tag me-1 opacity-50"></i> Resident Type</p>
                  <div class="info-value text-capitalize">
                    <%= residentType %>
                  </div>
                </div>
                <div class="col-md-6">
                  <p class="info-label"><i class="fa-solid fa-user me-1 opacity-50"></i> Primary Resident</p>
                  <div class="info-value">
                    <%= resident?.firstName %>
                      <%= resident?.lastName %>
                  </div>

                  <p class="info-label"><i class="fa-solid fa-mobile-screen me-1 opacity-50"></i> Contact</p>
                  <div class="info-value">
                    <%= resident?.firstMobileNo %>
                  </div>
                </div>
              </div>

              <hr class="my-4 opacity-10">

              <!-- Final Save Form -->
              <form method="POST" action="/flatStayMaster/finalSaveResident" enctype="multipart/form-data">
                <!-- Hidden Meta -->
                <input type="hidden" name="flat" value="<%= flatId %>">
                <input type="hidden" name="residentType" value="<%= residentType %>">
                <% if (residentType==="member" ) { %>
                  <input type="hidden" name="member" value="<%= memberId %>">
                  <% } else { %>
                    <input type="hidden" name="tenant" value="<%= tenantId %>">
                    <% } %>

                      <div class="row g-4">
                        <!-- Stay Dates -->
                        <div class="col-md-6">
                          <label class="form-label">Stay Starts From</label>
                          <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i
                                class="fa-regular fa-calendar-plus text-success"></i></span>
                            <input type="date" name="stayFrom" class="form-control border-start-0" required>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label">Stay Ends On (Optional)</label>
                          <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i
                                class="fa-regular fa-calendar-minus text-danger"></i></span>
                            <input type="date" name="stayTo" class="form-control border-start-0">
                          </div>
                        </div>
                        <% const documentTypes=locals.documentTypes || []; %>


                          <!-- Tenant Specific Section -->
                          <% if (residentType==="tenant" ) { %>
                            <div class="col-12 mt-4 animate__animated animate__fadeIn">
                              <div class="alert alert-premium shadow-sm border-0 p-4">
                                <div class="d-flex align-items-center mb-3">
                                  <i class="fa-solid fa-shield-halved fs-3 me-3 opacity-75"></i>
                                  <h5 class="fw-bold mb-0">Tenant Verification Required</h5>
                                </div>
                                <p class="small mb-3">For society security, please upload one of the following official
                                  documents:</p>

                                <div class="row g-3">
                                  <div class="col-md-6">
                                    <label class="form-label">Verification Type</label>

                                    <select id="docTypeSelect" name="documentType" class="form-select" required>
                                      <option value="">-- Choose Document --</option>

                                      <% documentTypes.forEach(type=> { %>
                                        <option value="<%= type %>">
                                          <%= type.replace(/_/g, " " ) %>
                                        </option>
                                        <% }) %>
                                    </select>
                                    <input type="hidden" name="selectedDocumentType" id="selectedDocumentType">
                                    <input type="hidden" name="selectedFilesPath" id="selectedFilesPath">

                                    <div id="docPreview" class="mt-3"></div>

                                  </div>
                                </div>
                              </div>
                            </div>
                            <% } %>

                              <% if (locals.error) { %>
                                <div class="col-12">
                                  <div class="alert alert-danger mb-0 rounded-4 py-2">
                                    <%= error %>
                                  </div>
                                </div>
                                <% } %>

                                  <div class="col-12 mt-5">
                                    <button class="btn btn-save w-100 shadow">
                                      <i class="fa-solid fa-circle-check me-2"></i> Confirm Resident Stay
                                    </button>
                                  </div>
                      </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include("../partials/script") %>
    <script>
      const tenantId = "<%= tenantId %>";
      const select = document.getElementById("docTypeSelect");
      const preview = document.getElementById("docPreview");

      const hiddenDocType = document.getElementById("selectedDocumentType");
      const hiddenFilesPath = document.getElementById("selectedFilesPath");

      select.addEventListener("change", async function () {
        const docType = this.value;

        // reset hidden values
        hiddenDocType.value = "";
        hiddenFilesPath.value = "";

        if (!docType) {
          preview.innerHTML = "";
          return;
        }

        preview.innerHTML = "Loading...";

        try {
          const res = await fetch(`/tenant/api/tenant-document?tenantId=${tenantId}&docType=${docType}`);
          const data = await res.json();

          if (!data.success) {
            preview.innerHTML = `<p style="color:red;">${data.message}</p>`;
            return;
          }

          const files = data.doc.filesPath || [];

          if (!files.length) {
            preview.innerHTML = `<p style="color:red;">No file found.</p>`;
            return;
          }

          // ✅ store selected data in hidden inputs (form submit ma backend ma jase)
          hiddenDocType.value = data.doc.documentType;
          hiddenFilesPath.value = JSON.stringify(files);

          preview.innerHTML = `
        <div class="p-2 border rounded">
          <p><b>Selected:</b> ${data.doc.documentType}</p>
          ${files.map((p, i) => `
            <a href="${p}" target="_blank" class="btn btn-sm btn-primary me-2 mb-2">
              View File ${i + 1}
            </a>
          `).join("")}
        </div>
      `;
        } catch (err) {
          console.log("AJAX Error:", err);
          preview.innerHTML = `<p style="color:red;">Something went wrong</p>`;
        }
      });
    </script>



</body>

</html>