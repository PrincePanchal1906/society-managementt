<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Flat</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Animate Config -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
      body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #e0f7fa, #e1f5fe);
        min-height: 100vh;
      }

      .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.5);
        animation: fadeInUp 0.6s ease-out;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .card-header-custom {
        text-align: center;
        margin-bottom: 2rem;
      }

      .header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        margin: 0 auto 1rem;
        box-shadow: 0 10px 20px rgba(0, 242, 254, 0.3);
      }

      .form-label {
        font-weight: 600;
        color: #546e7a;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }

      .input-group-text {
        background: #f1f8e9;
        border: 1px solid #cfd8dc;
        border-right: none;
        color: #78909c;
        border-top-left-radius: 12px;
        border-bottom-left-radius: 12px;
      }

      .form-control,
      .form-select,
      textarea.form-control {
        border: 1px solid #cfd8dc;
        padding: 0.7rem 1rem;
        border-radius: 12px;
        font-size: 0.95rem;
        background: #fafafa;
        transition: all 0.3s;
      }

      .input-group .form-control,
      .input-group .form-select {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
      }

      .form-control:focus,
      .form-select:focus {
        box-shadow: 0 0 0 4px rgba(79, 172, 254, 0.15);
        border-color: #4facfe;
        background: white;
      }

      .btn-submit {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        border: none;
        padding: 12px;
        font-weight: 600;
        letter-spacing: 1px;
        border-radius: 12px;
        text-transform: uppercase;
        font-size: 0.9rem;
        transition: all 0.3s;
        color: white;
      }

      .btn-submit:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        box-shadow: 0 10px 25px rgba(0, 242, 254, 0.4);
        color: white;
      }

      .btn-back {
        color: #607d8b;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1.5rem;
        padding: 8px 16px;
        border-radius: 10px;
        background: white;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        transition: all 0.2s;
      }

      .btn-back:hover {
        transform: translateX(-5px);
        color: #37474f;
        background: #eceff1;
      }

      .alert-custom {
        background: #ffebee;
        border-left: 5px solid #ef5350;
        color: #c62828;
        border-radius: 8px;
        font-size: 0.9rem;
      }
    </style>
</head>

<body>

  <div class="container-fluid p-0">
    <div class="row g-0">

      <div class="col-2">
        <%- include("../partials/leftSidebar") %>
      </div>

      <div class="col-10 d-flex flex-column align-items-center justify-content-center py-5" style="min-height: 100vh;">
        <div style="width: 100%; max-width: 480px;">

          <a href="/flat" class="btn-back animate__animated animate__fadeInLeft">
            <i class="fa-solid fa-arrow-left"></i> Back to Flats
          </a>

          <div class="glass-card p-4 p-md-5">

            <div class="card-header-custom">
              <div class="header-icon">
                <i class="fa-solid fa-house-chimney"></i>
              </div>
              <h3 class="fw-bold text-dark mb-1">Add New Flat</h3>
              <p class="text-muted small">Configure a new flat unit</p>
            </div>

            <% if (error) { %>
              <div class="alert alert-custom d-flex align-items-center mb-4 p-3 shadow-sm">
                <i class="fa-solid fa-circle-exclamation me-3 fs-5"></i>
                <div>
                  <%= error %>
                </div>
              </div>
              <% } %>

                <form method="POST" action="/flat/addFlat">

                  <!-- BLOCK -->
                  <div class="mb-4">
                    <label class="form-label">Block Name</label>
                    <div class="input-group">
                      <span class="input-group-text"><i class="fa-regular fa-building"></i></span>
                      <select name="blockName" id="blockSelect" class="form-select" required
                        onchange="fillBlockConfig()">
                        <option value="">-- Select Block --</option>
                        <% blocks.forEach(block=> { %>
                          <option value="<%= block.blockName %>" data-bedroom="<%= block.numberOfBedroom %>"
                            data-hall="<%= block.numberOfHall %>" data-kitchen="<%= block.numberOfKitchen %>"
                            data-size="<%= block.sizeOfFlats %>" data-unit="<%= block.sizeUnit %>"
                            <%=oldData?.blockName===block.blockName ? "selected" : "" %>>
                            <%= block.blockName %>
                          </option>
                          <% }) %>
                      </select>
                    </div>
                  </div>

                  <!-- FLAT NO -->
                  <div class="mb-4">
                    <label class="form-label">Flat Number</label>
                    <div class="input-group">
                      <span class="input-group-text"><i class="fa-solid fa-door-open"></i></span>
                      <input type="text" name="flatNo" class="form-control" value="<%= oldData?.flatNo || '' %>"
                        inputmode="numeric" maxlength="5" oninput="validateNumber(this)" required>
                    </div>
                  </div>

                  <!-- BEDROOM -->
                  <div class="mb-4">
                    <label class="form-label">Number of Bedroom</label>
                    <div class="input-group">
                      <span class="input-group-text"><i class="fa-solid fa-bed"></i></span>
                      <input type="text" id="bedroom" name="numberOfBedroom" class="form-control" maxlength="1"
                        inputmode="numeric" oninput="singleDigitOnly(this)" required>
                    </div>
                  </div>

                  <!-- HALL -->
                  <div class="mb-4">
                    <label class="form-label">Number of Hall</label>
                    <div class="input-group">
                      <span class="input-group-text"><i class="fa-solid fa-couch"></i></span>
                      <input type="text" id="hall" name="numberOfHall" class="form-control" maxlength="1"
                        inputmode="numeric" oninput="singleDigitOnly(this)" required>
                    </div>
                  </div>

                  <!-- KITCHEN -->
                  <div class="mb-4">
                    <label class="form-label">Number of Kitchen</label>
                    <div class="input-group">
                      <span class="input-group-text"><i class="fa-solid fa-utensils"></i></span>
                      <input type="text" id="kitchen" name="numberOfKitchen" class="form-control" maxlength="1"
                        inputmode="numeric" oninput="singleDigitOnly(this)" required>
                    </div>
                  </div>

                  <!-- SIZE -->
                  <div class="mb-4">
                    <label class="form-label">Flat Size</label>

                    <div class="input-group mb-2">
                      <span class="input-group-text"><i class="fa-solid fa-ruler"></i></span>
                      <select name="sizeUnit" id="sizeUnit" class="form-select" required>
                        <option value="">Select Unit</option>
                        <option value="SQFT">Square Feet</option>
                        <option value="SQYD">Square Yard</option>
                        <option value="SQM">Square Meter</option>
                      </select>
                    </div>

                    <div class="input-group">
                      <span class="input-group-text"><i class="fa-solid fa-ruler-combined"></i></span>
                      <input type="number" name="flatSize" id="flatSize" class="form-control"
                        value="<%= oldData?.flatSize || '' %>" min="1"
                        oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                    </div>
                  </div>

                  <!-- SPECIALIZATION -->
                  <div class="mb-4">
                    <label class="form-label">Specialization</label>
                    <textarea name="specialization" rows="3"
                      class="form-control"><%= oldData?.specialization || '' %></textarea>
                  </div>

                  <div class="d-grid mt-5">
                    <button type="submit" class="btn btn-submit shadow">
                      <i class="fa-solid fa-plus me-2"></i> Create Flat
                    </button>
                  </div>

                </form>

          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include("../partials/script") %>

    <script>
      function fillBlockConfig() {
        const select = document.getElementById("blockSelect");
        const option = select.options[select.selectedIndex];

        if (!option || option.value === "") {
          document.getElementById("bedroom").value = "";
          document.getElementById("hall").value = "";
          document.getElementById("kitchen").value = "";
          document.getElementById("flatSize").value = "";
          document.getElementById("sizeUnit").value = "";
          return;
        }

        document.getElementById("bedroom").value = option.dataset.bedroom || "";
        document.getElementById("hall").value = option.dataset.hall || "";
        document.getElementById("kitchen").value = option.dataset.kitchen || "";
        document.getElementById("flatSize").value = option.dataset.size || "";
        document.getElementById("sizeUnit").value = option.dataset.unit || "";
      }

      document.addEventListener("DOMContentLoaded", fillBlockConfig);

      function validateNumber(input) {
        input.value = input.value.replace(/[^0-9]/g, '');
      }

      function singleDigitOnly(input) {
        input.value = input.value.replace(/[^0-9]/g, '');
        if (input.value.length > 1) input.value = input.value.slice(0, 1);
        if (input.value === '0') input.value = '';
      }
    </script>

</body>

</html>